        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#151642"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications"
    ],
    "extra": {
      "apiUrl": "http://172.22.240.1:3000"
    }
  }
}
